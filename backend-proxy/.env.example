# Required for cloud provider calls (never place this key in the mobile app).
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ASSISTANT_MODEL=gpt-5.4
OPENAI_AUX_MODEL=gpt-5.4-mini
OPENAI_PROXY_PORT=8787
OPENAI_PROXY_HOST=0.0.0.0
OPENAI_PROXY_REQUEST_TIMEOUT_MS=25000
OPENAI_PROXY_DEFAULT_PRIVACY_MODE=minimal
OPENAI_PROXY_DEFAULT_STORE=false
