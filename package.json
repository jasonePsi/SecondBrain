{
  "name": "second_brain_mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "setup:proxy": "npm --prefix backend-proxy ci",
    "setup:all": "npm run setup:proxy",
    "test:hardening": "node --no-warnings --test --experimental-strip-types tests/*.test.mjs",
    "test:proxy": "npm run setup:proxy && npm --prefix backend-proxy run verify",
    "test": "npm run test:hardening",
    "verify": "npm run typecheck && npm test",
    "verify:all": "npm run verify && npm run test:proxy"
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "^15.2.5",
    "@shopify/flash-list": "2.0.2",
    "expo": "~54.0.33",
    "expo-background-task": "~1.0.10",
    "expo-battery": "~10.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-file-system": "^19.0.21",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-speech-recognition": "^3.1.0",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "llama.rn": "^0.11.0-rc.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "ajv": "^8.18.0",
    "brace-expansion@2.0.2": "2.0.3",
    "node-forge": "^1.4.0",
    "tar": "^7.5.11",
    "undici": "^6.24.0",
    "yaml": "^2.8.3"
  },
  "private": true
}
